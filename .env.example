# Google Maps Directions API key
GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# CARTO Basemaps API key (optional; required for the CartoDB Dark layer)
CARTO_BASEMAP_API_KEY="YOUR_CARTO_BASEMAP_API_KEY"

# Tailscale IP of the Android phone running MacroDroid HTTP Server
PHONE_TAILSCALE_IP="100.x.x.x"

# Dashboard login secret. Any non-empty value is accepted.
API_SECRET_KEY="replace_with_a_long_random_secret"

# Optional API-only access key and Flask session signing secret.
# Omit them to reuse API_SECRET_KEY, or set any non-empty values.
API_ACCESS_KEY="replace_with_a_different_random_secret"
FLASK_SESSION_SECRET="replace_with_another_random_secret"

# Extra network interface to share the dashboard on.
#   127.0.0.1  local only (default, recommended)
#   100.x.x.x  this PC's Tailscale IP, to reach the dashboard from the phone
# 127.0.0.1 always stays available, so http://127.0.0.1:5050/map keeps working
# whatever you set here. Do not use 0.0.0.0: it exposes the unencrypted
# dashboard to the whole LAN.
BIND_HOST="127.0.0.1"
FLASK_PORT=5050

# Runtime timezone (IANA name)
TZ="Asia/Taipei"
